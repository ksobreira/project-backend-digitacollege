{
  "name": "project-backend-digitacollege",
  "version": "1.0.0",
  "description": "API REST de e-commerce (usuários, categorias e produtos) com Node.js, Express, Sequelize, MySQL e JWT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand",
    "db:create": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ksobreira/project-backend-digitacollege.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/ksobreira/project-backend-digitacollege/issues"
  },
  "homepage": "https://github.com/ksobreira/project-backend-digitacollege#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup-env.js"
    ],
    "testTimeout": 20000
  }
}