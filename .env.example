# Servidor
PORT=3000
BASE_URL=http://localhost:3000

# Banco de dados (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=root
DB_NAME=projeto_backend

# JWT
JWT_SECRET=troque-este-segredo
JWT_EXPIRES_IN=1h

# Código HTTP quando o header Authorization NÃO é enviado (401 ou 400).
# O escopo cita 401 nos endpoints e 400 na Seção 05; o padrão adotado é 401.
AUTH_MISSING_TOKEN_STATUS=401

# Pasta onde as imagens dos produtos são gravadas (opcional)
# UPLOAD_DIR=./uploads
